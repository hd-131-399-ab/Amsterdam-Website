---
const links = [
  { href: "/collections", label: "Collections" },
  { href: "/pictures", label: "Fotos" },
  { href: "/videos", label: "Videos" },
  { href: "/quotes", label: "Zitate" },
];

const current = Astro.url.pathname.replace(/\/$/, "");
---

<nav>
  <ul class="nav-list">
    {links.map(({ href, label }) => (
      <li>
        <a href={href} class="nav-button" aria-current={current === href ? "page" : undefined}>
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-button {
    --glow: transparent;

    position: relative;
    display: block;
    padding: .3em 1.1em;

    font-size: 1.3rem;
    text-decoration: none;
    color: var(--bar-text);

    /* Frosted fill plus a gradient border via the padding-box/border-box trick */
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--leaf-200) 22%, transparent),
        color-mix(in srgb, var(--leaf-950) 35%, transparent)
      ) padding-box,
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--leaf-200) 70%, transparent),
        color-mix(in srgb, var(--pistil) 50%, transparent) 50%,
        color-mix(in srgb, var(--leaf-600) 40%, transparent)
      ) border-box;
    border: 2px solid transparent;
    border-radius: 999px;
    backdrop-filter: blur(6px);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--paper) 25%, transparent),
      0 4px 14px var(--shadow),
      0 0 18px var(--glow);

    transition: transform .2s, box-shadow .2s, color .2s;
  }

  /* Red-eye dot that grows in under the label */
  .nav-button::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: .2em;
    width: 0;
    height: 3px;
    border-radius: 999px;
    background: var(--red-eye-gradient);
    transform: translateX(-50%);
    transition: width .2s;
  }

  .nav-button:hover,
  .nav-button:focus-visible {
    --glow: color-mix(in srgb, var(--red-eye-vein) 55%, transparent);
    color: var(--red-eye-white);
    transform: translateY(-2px);
  }

  .nav-button:hover::after,
  .nav-button:focus-visible::after {
    width: 40%;
  }

  .nav-button[aria-current="page"] {
    --glow: color-mix(in srgb, var(--red-eye) 45%, transparent);
    color: var(--red-eye-white);
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--red-eye) 55%, transparent),
        color-mix(in srgb, var(--leaf-950) 50%, transparent)
      ) padding-box,
      linear-gradient(135deg, var(--red-eye-vein), var(--red-eye)) border-box;
  }

  .nav-button[aria-current="page"]::after {
    width: 60%;
  }

  .nav-button:focus-visible {
    outline: 2px dashed var(--red-eye-white);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-button,
    .nav-button::after {
      transition: none;
    }
  }
</style>
