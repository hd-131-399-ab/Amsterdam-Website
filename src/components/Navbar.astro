---
const links = [
  { href: "/collections", label: "Collections" },
  { href: "/pictures", label: "Fotos" },
  { href: "/videos", label: "Videos" },
  { href: "/quotes", label: "Zitate" },
];

const current = Astro.url.pathname.replace(/\/$/, "");
---

<nav>
  <button
    type="button"
    class="burger"
    aria-label="Menü"
    aria-expanded="false"
    aria-controls="nav-list"
  >
    <span></span><span></span><span></span>
  </button>

  <ul class="nav-list" id="nav-list">
    {links.map(({ href, label }) => (
      <li>
        <a href={href} class="nav-button" aria-current={current === href ? "page" : undefined}>
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  const nav = document.querySelector("nav")!;
  const burger = nav.querySelector<HTMLButtonElement>(".burger")!;

  const setOpen = (open: boolean) => {
    burger.setAttribute("aria-expanded", String(open));
    nav.toggleAttribute("data-open", open);
  };

  burger.addEventListener("click", () => setOpen(burger.getAttribute("aria-expanded") !== "true"));
  nav.addEventListener("click", (e) => {
    if ((e.target as Element).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
</script>

<style>
  .burger {
    display: none;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 40rem) {
    .burger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 2.6rem;
      height: 2.6rem;
      padding: 0 .7rem;

      background: var(--glass-tint);
      border: 1px solid var(--glass-edge);
      border-radius: 999px;
      cursor: pointer;
    }

    .burger span {
      height: 2px;
      background: var(--text);
      border-radius: 2px;
      transition: transform .2s, opacity .2s;
    }

    .burger:focus-visible {
      outline: 2px solid var(--heading);
      outline-offset: 2px;
    }

    nav[data-open] .burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    nav[data-open] .burger span:nth-child(2) { opacity: 0; }
    nav[data-open] .burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* Dropdown anchored to the sticky header */
    .nav-list {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      padding: .75rem 1rem;
      background: color-mix(in srgb, var(--paper) 92%, transparent);
      border-bottom: 1px solid var(--glass-edge);
      box-shadow: 0 6px 12px var(--shadow);
    }

    nav[data-open] .nav-list {
      display: flex;
    }

    .nav-button {
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .burger span {
      transition: none;
    }
  }

  .nav-button {
    display: block;
    padding: .2em 1em;

    font-size: 1.3rem;
    text-decoration: none;
    color: var(--text);

    background: var(--glass-tint);
    border: 1px solid var(--glass-edge);
    border-radius: 999px;
    box-shadow:
      inset 0 1px 0 var(--glass-highlight),
      inset 0 -1px 0 var(--glass-shade),
      0 1px 3px var(--shadow);

    transition: background .2s, color .2s;
  }

  .nav-button:hover {
    background: var(--glass-tint-strong);
  }

  .nav-button[aria-current="page"] {
    color: var(--red-eye);
    background: color-mix(in srgb, var(--red-eye-vein) 30%, transparent);
    border-color: color-mix(in srgb, var(--red-eye-vein) 60%, transparent);
  }

  .nav-button:focus-visible {
    outline: 2px solid var(--heading);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-button {
      transition: none;
    }
  }
</style>
