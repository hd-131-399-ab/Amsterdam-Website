---
const links = [
  { href: "/collections", label: "Collections" },
  { href: "/pictures", label: "Fotos" },
  { href: "/videos", label: "Videos" },
  { href: "/quotes", label: "Zitate" },
];

const current = Astro.url.pathname.replace(/\/$/, "");
---

<nav>
  <ul class="nav-list">
    {links.map(({ href, label }) => (
      <li>
        <a href={href} class="nav-button" aria-current={current === href ? "page" : undefined}>
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-button {
    display: block;
    padding: .2em 1em;

    font-size: 1.3rem;
    text-decoration: none;
    color: var(--text);

    background: var(--glass-tint);
    border: 1px solid var(--glass-edge);
    border-radius: 999px;
    box-shadow:
      inset 0 1px 0 var(--glass-highlight),
      inset 0 -1px 0 var(--glass-shade),
      0 1px 3px var(--shadow);

    transition: background .2s, color .2s;
  }

  .nav-button:hover {
    background: var(--glass-tint-strong);
  }

  .nav-button[aria-current="page"] {
    color: var(--red-eye);
    background: color-mix(in srgb, var(--red-eye-vein) 30%, transparent);
    border-color: color-mix(in srgb, var(--red-eye-vein) 60%, transparent);
  }

  .nav-button:focus-visible {
    outline: 2px solid var(--heading);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-button {
      transition: none;
    }
  }
</style>
