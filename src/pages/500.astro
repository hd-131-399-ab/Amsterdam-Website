---
import MainLayout from "../layouts/MainLayout.astro"

interface Props {
  error: unknown;
}

const { error } = Astro.props;
---

<MainLayout>
  <section class="paper glass error">
    <h1>500</h1>
    <p>{error instanceof Error ? error.message : "Unknown error"}</p>
  </section>
</MainLayout>

<style>
  .error {
    max-width: 30rem;
    margin: 0 auto;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: 5rem;
    color: var(--red-eye);
  }
</style>
