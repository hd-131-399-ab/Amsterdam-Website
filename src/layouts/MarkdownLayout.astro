---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>
  <article class="prose paper glass">
    <slot />
  </article>
</MainLayout>

<style>
  .prose {
    max-width: 50rem;
    margin: 0 auto;
  }

  .prose :global(h1) {
    margin-top: 0;
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    text-decoration: underline wavy var(--red-eye-vein);
    text-underline-offset: .2em;
    text-decoration-thickness: 2px;
  }

  .prose :global(h2) {
    margin: .4em 0;
    font-size: 1.8rem;
  }

  /* .prose :global(h2)::before {
    content: "🌿 ";
  } */

  .prose :global(a)    { color: var(--accent); }
  .prose :global(code) { color: var(--pistil); }

  .prose :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
