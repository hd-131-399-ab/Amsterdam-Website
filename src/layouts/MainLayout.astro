---
import { Font } from "astro:assets";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../assets/styles/global.css";
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-hand" preload />
		<Font cssVariable="--font-hand-display" preload />
		<title>Amsterdam 2026</title>
	</head>

	<body>
		<!-- Refraction for .glass: low-frequency noise bends the backdrop slightly -->
		<svg class="defs" aria-hidden="true">
			<filter id="glass-distortion" x="0" y="0" width="100%" height="100%">
				<feTurbulence type="fractalNoise" baseFrequency="0.006 0.014" numOctaves="2" seed="7" result="noise" />
				<feDisplacementMap in="SourceGraphic" in2="noise" scale="14" xChannelSelector="R" yChannelSelector="G" />
			</filter>
		</svg>

		<div class="main-container">
			<header class="nav-container glass">
				<a class="wordmark" href="/">Amsterdam <span>'26</span></a>

				<Navbar />
			</header>

			<main class="slot-container">
				<slot />
			</main>

			<div>
				<Footer/>
			</div>
		</div>
	</body>
</html>

<style>
	html, body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

	body {
		background: var(--background) url("../assets/grid.svg") center / cover no-repeat fixed;
	}

	.defs {
		position: absolute;
		width: 0;
		height: 0;
	}

	.main-container {
		display: grid;
		grid-template-rows: auto 1fr auto;
		min-height: 100dvh;
	}

	.nav-container {
		position: sticky;
		top: 0;
		z-index: 1;

		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: .5rem 1.5rem;
		padding: .6rem clamp(1rem, 3vw, 2.5rem);

		border-width: 0 0 1px;
	}

	.wordmark {
		font-family: var(--font-display);
		font-size: 2rem;
		color: var(--heading);
		text-decoration: none;
	}

	.wordmark span {
		color: var(--red-eye);
	}

	.slot-container {
		padding: clamp(1rem, 5vw, 4rem);
	}

</style>
